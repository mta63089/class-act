# Use your real public site URL before deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Generate two different values with: openssl rand -base64 48
BETTER_AUTH_SECRET=
CMS_SETUP_TOKEN=

# Manual AI research and draft generation (server only; never prefix with NEXT_PUBLIC_).
# Create an API key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Use an available model with Responses web_search and structured outputs.
OPENAI_MODEL=gpt-5

# mock or openai are available values
AI_PROVIDER=mock
# For a private staging site only; public demo content is noindexed.
# ALLOW_DEMO_PUBLICATION=true
