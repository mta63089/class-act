# Public site and admin authentication.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Generate distinct values using: openssl rand -base64 48
BETTER_AUTH_SECRET=
CMS_SETUP_TOKEN=

OPENAI_API_KEY=
# mock = no paid calls; openai = live paid generation from Generate buttons.
AI_PROVIDER=mock

# Separate models for source research and article writing.
OPENAI_RESEARCH_MODEL=gpt-5.4-mini
OPENAI_WRITER_MODEL=gpt-6.2-sol
# Generous ceilings, not pre-paid tokens or guaranteed costs.
OPENAI_RESEARCH_MAX_OUTPUT_TOKENS=25000
OPENAI_WRITER_MAX_OUTPUT_TOKENS=25000

# Demo publishing stays disabled on public deployments unless explicitly enabled.
# ALLOW_DEMO_PUBLICATION=true
