  },
  "devDependencies": {
    "@opennextjs/cloudflare": "latest",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "wrangler": "latest"
  },
  "engines": { "node": ">=20.9.0" }
}
