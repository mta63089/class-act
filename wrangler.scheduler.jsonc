{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "class-act-news-scheduler",
  "main": "src/worker/news-scheduler.ts",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["*/15 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "class-act-db",
      "database_id": "bceba796-0360-4ee1-b1d1-83245d2626f2",
      "migrations_dir": "drizzle"
    }
  ]
}
